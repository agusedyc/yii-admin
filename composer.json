{
    "name": "agusedyc/yii-admin",
    "type": "library",
    "description": "RBAC admin panel and authorization helpers for Yii3. Non-backward-compatible port of agusedyc/yii2-mimin built on yiisoft/rbac.",
    "keywords": [
        "yii3",
        "rbac",
        "admin",
        "access-control",
        "permission"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Agus Dyc",
            "email": "agusedyc@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "yiisoft/access": "^2.0",
        "yiisoft/aliases": "^3.0",
        "yiisoft/config": "^1.6",
        "yiisoft/csrf": "^2.0",
        "yiisoft/db": "^2.0",
        "yiisoft/db-migration": "^2.0",
        "yiisoft/html": "^4.0",
        "yiisoft/rbac": "^2.0",
        "yiisoft/rbac-db": "^2.0",
        "yiisoft/router": "^4.0",
        "yiisoft/session": "^3.0",
        "yiisoft/user": "^2.0",
        "yiisoft/validator": "^2.0",
        "yiisoft/view": "^12.0",
        "yiisoft/yii-console": "^2.0",
        "yiisoft/yii-view-renderer": "^7.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "httpsoft/http-message": "^1.1",
        "phpunit/phpunit": "^10.5",
        "rector/rector": "^2.0",
        "vimeo/psalm": "^5.26 || ^6.0",
        "yiisoft/db-mysql": "^2.0",
        "yiisoft/db-pgsql": "^2.0",
        "yiisoft/db-sqlite": "^2.0",
        "yiisoft/cache": "^3.0",
        "yiisoft/di": "^1.4",
        "yiisoft/injector": "^1.0",
        "yiisoft/router-fastroute": "^4.0"
    },
    "suggest": {
        "yiisoft/db-pgsql": "PostgreSQL driver (primary supported driver)",
        "yiisoft/db-mysql": "MySQL driver",
        "yiisoft/db-sqlite": "SQLite driver",
        "yiisoft/router-fastroute": "Route implementation for the Yii3 router"
    },
    "autoload": {
        "psr-4": {
            "Agusedyc\\Admin\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Agusedyc\\Admin\\Tests\\": "tests"
        }
    },
    "extra": {
        "config-plugin-options": {
            "source-directory": "config"
        },
        "config-plugin": {
            "params": "params.php",
            "di": "di.php",
            "routes": "routes.php"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/config": true
        }
    },
    "scripts": {
        "test": "phpunit --testdox --no-interaction",
        "psalm": "psalm --no-cache",
        "cs-fix": "php-cs-fixer fix",
        "rector": "rector"
    }
}
